# ==========================================
# FuturePath AI — Environment Configuration
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Backend Security
SECRET_KEY=futurepath_super_secret_production_key_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: SQLite file for instant local execution without external services
DATABASE_URL=sqlite:///./futurepath.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/futurepath

# Document Upload Storage Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=FuturePath AI
